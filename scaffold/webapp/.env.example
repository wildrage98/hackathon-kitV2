# 복사해서 .env 로 쓰거나 export 한다. 비밀값은 저장소에 넣지 않는다.
APP_NAME=__NAME__
HOST=0.0.0.0
PORT=8000
DB_PATH=./data/app.db          # SQLite. 재시작해도 데이터·결과 유지
EXPORT_DIR=./exports
SECRET_KEY=change-me-to-a-random-string
SESSION_TTL_MIN=480
ADMIN_USER=admin
ADMIN_PASSWORD=change-me       # 운영자
USER_PASSWORD=change-me        # 일반 사용자 공통 (아이디는 specs.USER_LOOKUP 기준)
